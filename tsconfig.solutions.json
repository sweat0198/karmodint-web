{
  "//": "Typechecks the Solution cover and copy migrations. Same reasoning as tsconfig.catalogue.json: the root tsconfig extends Nuxt's, which includes only app/, so scripts/ and tests/ need their own strict config.",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [
    "scripts/solutions/**/*.ts",
    "tests/solutions/**/*.ts",
    "scripts/catalogue/lib/paths.ts",
    "scripts/catalogue/lib/runScript.ts",
    "scripts/catalogue/lib/sanityEnv.ts",
    "scripts/catalogue/lib/pageCopy.ts",
    "scripts/catalogue/lib/redirectSources.ts"
  ]
}
